# =========================================================
# FreshersCompass — AI Service (Python / FastAPI) — .env.example
# Copy this file to `.env` in the same folder and fill in real values.
# Never commit the real `.env` file.
# =========================================================

# ---------- Server ----------
PORT=8000
ENV=development

# ---------- LLM Providers ----------
# Primary
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
# Fallback (used when Gemini rate limit / quota is hit)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-70b-versatile

# ---------- Database / Vector Search ----------
# Same MongoDB Atlas cluster as backend, with Vector Search enabled
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/freshercompass?retryWrites=true&w=majority
VECTOR_INDEX_NAME=codebase_vector_index
EMBEDDING_MODEL=text-embedding-004

# ---------- GitHub API (repo ingestion for RAG) ----------
GITHUB_TOKEN=your_github_personal_access_token

# ---------- Security ----------
# Must match JWT_SECRET in backend/.env so tokens can be verified here too
JWT_SECRET=replace_with_a_long_random_string
# Must match AI_SERVICE_INTERNAL_KEY in backend/.env
AI_SERVICE_INTERNAL_KEY=replace_with_a_shared_secret_for_backend_to_ai_calls

# ---------- CORS ----------
BACKEND_URL=http://localhost:5000

# ---------- Resume Parsing ----------
MAX_RESUME_PAGES=5
