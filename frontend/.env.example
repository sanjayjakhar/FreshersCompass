# =========================================================
# FreshersCompass — Frontend (React + Vite) — .env.example
# Copy this file to `.env` in the same folder and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# Never commit the real `.env` file, and never put secrets here —
# this file ships to the browser.
# =========================================================

VITE_API_BASE_URL=http://localhost:5000/api
VITE_AI_SERVICE_URL=http://localhost:8000

# Used only to build the GitHub OAuth "Connect GitHub" link
# (the actual client secret stays server-side, in backend/.env)
VITE_GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id

VITE_APP_NAME=FreshersCompass
