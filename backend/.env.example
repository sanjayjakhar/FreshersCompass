# =========================================================
# FreshersCompass — Backend (Node.js / Express) — .env.example
# Copy this file to `.env` in the same folder and fill in real values.
# Never commit the real `.env` file.
# =========================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# MongoDB Atlas connection string (also used for Vector Search by ai-service)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/freshercompass?retryWrites=true&w=majority

# ---------- Auth / Sessions ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_string
COOKIE_SECURE=false
# Set COOKIE_SECURE=true in production (requires HTTPS)

# ---------- OAuth: GitHub ----------
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ---------- OAuth: LinkedIn ----------
LINKEDIN_CLIENT_ID=your_linkedin_oauth_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_oauth_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

# ---------- AI Microservice ----------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=replace_with_a_shared_secret_for_backend_to_ai_calls

# ---------- CORS ----------
CLIENT_URL=http://localhost:5173

# ---------- File Upload (Resumes) ----------
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads/
ALLOWED_FILE_TYPES=pdf,docx

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
